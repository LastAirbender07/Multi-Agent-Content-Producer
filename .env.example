# ============================================
# LLM Provider Selection
# ============================================
# Options: "hai_proxy", "claude", "openai", "gemini", "sap_ai_core", "sap_ai_core_orch"
#
#   hai_proxy / claude  — Anthropic Claude via HAI Proxy (or direct Anthropic API)
#                         LLM_MODEL must be an Anthropic model ID:
#                           claude-3-5-sonnet-20241022, claude-3-haiku-20240307
#                         WARNING: do NOT use "anthropic--*" names here — those are
#                         SAP AI Core deployment names and will be rejected by Anthropic.
#   sap_ai_core_orch    — SAP AI Core Orchestration Service (Anthropic/Claude, GPT-4o…)
#                         LLM_MODEL is the model_name in your orchestration config:
#                           anthropic--claude-4.6-sonnet, gpt-4o
LLM_PROVIDER=sap_ai_core_orch

# ============================================
# HAI Proxy / Direct Claude Settings
# ============================================
# Required when LLM_PROVIDER=hai_proxy or claude
HAI_PROXY_URL=http://localhost:6655/anthropic
HAI_PROXY_API_KEY=your-hai-proxy-api-key-here

# ============================================
# OpenAI Settings
# ============================================
# Required when LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1  # Optional, for custom endpoints

# ============================================
# Google Gemini Settings
# ============================================
# Required when LLM_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-api-key-here

# ============================================
# SAP AI Core Settings
# ============================================
# Required when LLM_PROVIDER=sap_ai_core OR sap_ai_core_orch
# These are read directly by the sap-ai-sdk-gen library from the environment.
#
# AICORE_CLIENT_ID=your-service-key-client-id
# AICORE_CLIENT_SECRET=your-service-key-client-secret
# AICORE_AUTH_URL=https://<subdomain>.authentication.<region>.hana.ondemand.com
# AICORE_BASE_URL=https://api.ai.<region>.aws.ml.hana.ondemand.com
# AICORE_RESOURCE_GROUP=default
#
# For sap_ai_core (direct deployment):
#   LLM_MODEL must be the exact deployment name in AI Core (e.g. "claude-4-5-sonnet")
#   This is the "name" you gave the deployment in AI Launchpad.
#
# For sap_ai_core_orch (Orchestration Service):
#   LLM_MODEL is the model_name field in the LLM module config.
#   Typically: "anthropic--claude-4.5-sonnet" or "gpt-4o" depending on your scenario.
#
# SAP_AICORE_DEPLOYMENT_URL is only needed for sap_ai_core (direct deployment).
# It is the "Deployment URL" shown in AI Launchpad for your specific deployment.
# AICORE_DEPLOYMENT_URL=https://api.ai.<region>.aws.ml.hana.ondemand.com/v2/inference/deployments/<deployment-id>

# ============================================
# General LLM Settings
# ============================================
# Model name — interpretation depends on provider:
#   hai_proxy / claude  → Anthropic model ID:       claude-3-5-sonnet-20241022
#   openai              → OpenAI model ID:           gpt-4o
#   gemini              → Gemini model ID:           gemini-1.5-pro
#   sap_ai_core         → AI Launchpad deploy name   (the name you gave the deployment)
#   sap_ai_core_orch    → Orchestration model name:  anthropic--claude-4.6-sonnet
LLM_MODEL=anthropic--claude-4.6-sonnet

# LLM parameters
LLM_TIMEOUT=300.0
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=1.0

# ============================================
# Logging Settings
# ============================================
LOG_LEVEL=INFO
ENVIRONMENT=development

# Other API Keys
NEWSAPI_API_KEY=
PEXELS_API_KEY=
GOOGLE_BLOGGER_OAUTH_CLIENT_ID=
GOOGLE_BLOGGER_OAUTH_CLIENT_SECRET=